# CareerGPS Frontend Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit real keys to git

# Backend API URL
# Use your Render backend URL in production
VITE_API_URL=http://your-backend-url.com

# Supabase project URL (public)
# Get this from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (public, safe to expose in frontend)
# Get this from your Supabase project dashboard → Settings → API
VITE_SUPABASE_ANON_KEY=your-anon-key-here
